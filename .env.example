# ==============================================================================
# World Monitor — Optional Realtime Upstream Keys (.env)
# ==============================================================================
# Copy this file to `.env` if you want to unlock global AISStream WebSocket
# vessel coverage in the East Sea (Biển Đông), Malacca, Taiwan, Hormuz & Suez.
# Without `.env`, the system still runs 100% live using keyless streams
# (Binance WS, adsb.lol 10s + Dead-Reckoning, Digitraffic Open AIS, USGS, etc.).

# Free GitHub sign-in at https://aisstream.io/ -> API Keys
AISSTREAM_API_KEY=

# Optional backend port (defaults to 8787)
PORT=8787
