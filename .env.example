# ==============================================================================
# World Monitor — Optional Realtime & AI Keys (.env)
# ==============================================================================
# Without `.env`, the entire dashboard runs 100% live using keyless upstream APIs.

# 1. AISStream.io (Free GitHub sign-in at https://aisstream.io/)
# Unlocks live maritime AIS vessel tracking across Biển Đông, Malacca, Taiwan, Hormuz & Red Sea
AISSTREAM_API_KEY=

# 2. Groq LPU Cloud Free Tier (https://console.groq.com/keys)
# Unlocks ultra-fast AI Sitrep Briefing, Interactive "Ask Monitor" Copilot, and 3-bullet Legal AI Summaries
GROQ_API_KEY=

# 3. Federal Reserve Economic Data — FRED (https://fred.stlouisfed.org/docs/api/api_key.html)
# Unlocks live Fed Funds Rate, US 10Y/2Y/3M Treasury Yields, Net Liquidity, VIX & Broad USD Index
FRED_API_KEY=

# 4. NASA FIRMS Satellite MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# Upgrades satellite thermal detection to 375m NOAA-20 VIIRS NRT across Vietnam/Biển Đông/ASEAN & Conflict Zones
NASA_FIRMS_API_KEY=

# 5. Optional Google AI Studio Free Tier fallback (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 6. Optional Telegram Bot (headless background alerts strictly for new HPT corporate items)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 7. Optional Free HPT Social Listening Extensions ($0 tier — leave blank to use built-in keyless RSS/Telegram)
# - Serper.dev Google SERP JSON API (free 2,500 queries without credit card; disk-cached & throttled to 1 query/hour):
# SERPER_API_KEY=
# - Local SearXNG metasearch JSON endpoint (`npm run searxng:up` runs on http://127.0.0.1:8888 automatically; set `off` to disable):
# SEARXNG_BASE_URL=http://127.0.0.1:8888
# - Comma-separated extra public Telegram channel handles (`t.me/s/<handle>`) to scan for HPT mentions:
# HPT_TELEGRAM_CHANNELS=
# - Google Programmable Search JSON API (free 100 queries/day; auto-throttled to <=72/day for FB/LinkedIn/TikTok/Threads):
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# - Meta Graph API for HPT-managed Fanpage (`/{page-id}/tagged` & `visitor_posts`, excludes self-authored posts):
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=

# 8. Optional server network & reverse-proxy settings
PORT=8787
# HOST=127.0.0.1
# ALLOWED_ORIGINS=
# TRUST_PROXY=0
